        "operationId": "leaveQueue",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Left matching queue",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ApiResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/api/v1/calls/match": {
      "get": {
        "tags": ["Calls"],
        "summary": "Find match",
        "description": "Check for a matching call partner",
        "operationId": "findMatch",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Match result",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {"$ref": "#/components/schemas/ApiResponse"},
                    {
                      "type": "object",
                      "properties": {
                        "data": {"$ref": "#/components/schemas/MatchResult"}
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {"$ref": "#/components/responses/BadRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/api/v1/calls/start": {
      "post": {
        "tags": ["Calls"],
        "summary": "Start call",
