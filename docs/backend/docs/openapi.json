      "post": {
        "tags": ["Authentication"],
        "summary": "Verify email token",
        "description": "Verify user's email using the verification token sent via email",
        "operationId": "verifyEmail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/VerifyEmailRequest"}
