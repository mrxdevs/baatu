  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - validation error",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"}
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - authentication required or failed",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"}
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"}
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"}
          }
        }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {"type": "boolean"},
          "message": {"type": "string"},
          "data": {"type": "object"}
        },
        "required": ["success"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {"type": "boolean", "example": false},
          "error": {"type": "string"}
        },
        "required": ["success", "error"]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {"type": "string", "format": "email"},
          "password": {"type": "string", "minLength": 8},
          "name": {"type": "string", "minLength": 2}
        },
        "required": ["email", "password", "name"]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {"type": "string", "format": "email"},
          "password": {"type": "string"}
        },
        "required": ["email", "password"]
      },
      "GoogleAuthRequest": {
        "type": "object",
        "properties": {
          "id_token": {"type": "string"},
          "google_id": {"type": "string"},
          "email": {"type": "string", "format": "email"},
          "name": {"type": "string"}
        },
        "required": ["id_token", "google_id", "email", "name"]
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "token": {"type": "string"}
        },
        "required": ["token"]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {"type": "string", "format": "email"}
        },
        "required": ["email"]
      },
      "VerifyOTPRequest": {
        "type": "object",
        "properties": {
          "email": {"type": "string", "format": "email"},
          "otp": {"type": "string", "minLength": 6, "maxLength": 6}
        },
        "required": ["email", "otp"]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {"type": "string", "format": "email"},
          "otp": {"type": "string", "minLength": 6, "maxLength": 6},
          "new_password": {"type": "string", "minLength": 8}
        },
        "required": ["email", "otp", "new_password"]
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "bio": {"type": "string"},
          "native_language": {"type": "string"},
          "learning_language": {"type": "string"},
          "skill_level": {"type": "string"},
          "age_range": {"type": "string"},
          "gender": {"type": "string"},
          "location": {"type": "string"},
          "timezone": {"type": "string"},
          "interests": {"type": "array", "items": {"type": "string"}}
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {"type": "string"},
          "user": {"$ref": "#/components/schemas/User"},
          "profile": {"$ref": "#/components/schemas/UserProfile"}
        },
        "required": ["token", "user", "profile"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "email": {"type": "string", "format": "email"},
          "name": {"type": "string"},
          "auth_provider": {"type": "string", "enum": ["email", "google"]},
          "is_verified": {"type": "boolean"},
          "is_active": {"type": "boolean"},
          "last_login": {"type": "string", "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "user_id": {"type": "string", "format": "uuid"},
          "bio": {"type": "string"},
          "avatar_url": {"type": "string"},
          "native_language": {"type": "string"},
          "learning_language": {"type": "string"},
          "skill_level": {"type": "string", "enum": ["beginner", "intermediate", "advanced"]},
          "age_range": {"type": "string"},
          "gender": {"type": "string"},
          "location": {"type": "string"},
          "timezone": {"type": "string"},
          "interests": {"type": "array", "items": {"type": "string"}},
          "is_premium": {"type": "boolean"},
          "total_calls": {"type": "integer"},
          "total_minutes": {"type": "integer"},
          "current_streak": {"type": "integer"},
          "longest_streak": {"type": "integer"},
          "last_active_date": {"type": "string", "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "UserWithProfile": {
        "type": "object",
        "properties": {
          "user": {"$ref": "#/components/schemas/User"},
          "profile": {"$ref": "#/components/schemas/UserProfile"}
        }
      },
      "Word": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "word": {"type": "string"},
          "meaning": {"type": "string"},
          "pronunciation_url": {"type": "string"},
          "part_of_speech": {"type": "string"},
          "difficulty_level": {"type": "string", "enum": ["beginner", "intermediate", "advanced"]},
          "example_sentence": {"type": "string"},
          "synonyms": {"type": "array", "items": {"type": "string"}},
          "antonyms": {"type": "array", "items": {"type": "string"}},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "UserWord": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "user_id": {"type": "string", "format": "uuid"},
          "word_id": {"type": "integer"},
          "is_learned": {"type": "boolean"},
          "saved_at": {"type": "string", "format": "date-time"},
          "learned_at": {"type": "string", "format": "date-time"},
          "word": {"$ref": "#/components/schemas/Word"}
        }
      },
      "DailyWordsResponse": {
        "type": "object",
        "properties": {
          "date": {"type": "string", "format": "date"},
          "word_of_day": {"$ref": "#/components/schemas/Word"},
          "words": {"type": "array", "items": {"$ref": "#/components/schemas/Word"}},
          "total_words": {"type": "integer"}
        }
      },
      "Call": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "caller_id": {"type": "string", "format": "uuid"},
          "callee_id": {"type": "string", "format": "uuid"},
          "status": {"type": "string", "enum": ["pending", "active", "completed", "missed", "cancelled"]},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "duration_seconds": {"type": "integer"},
          "created_at": {"type": "string", "format": "date-time"},
          "caller": {"$ref": "#/components/schemas/User"},
          "callee": {"$ref": "#/components/schemas/User"}
        }
      },
      "JoinQueueRequest": {
        "type": "object",
        "properties": {
          "skill_level": {"type": "string", "enum": ["beginner", "intermediate", "advanced"]},
          "gender_preference": {"type": "string"},
          "age_preference": {"type": "string"}
        }
      },
      "StartCallRequest": {
        "type": "object",
        "properties": {
          "callee_id": {"type": "string", "format": "uuid"}
        },
        "required": ["callee_id"]
      },
      "EndCallRequest": {
        "type": "object",
        "properties": {
          "call_id": {"type": "string", "format": "uuid"},
          "duration_seconds": {"type": "integer"}
        },
        "required": ["call_id"]
      },
      "RateCallRequest": {
        "type": "object",
        "properties": {
          "thumbs_up": {"type": "boolean"}
        },
        "required": ["thumbs_up"]
      },
      "MatchResult": {
        "type": "object",
        "properties": {
          "found": {"type": "boolean"},
          "match_id": {"type": "string", "format": "uuid"},
          "user": {"$ref": "#/components/schemas/User"},
          "profile": {"$ref": "#/components/schemas/UserProfile"}
        },
        "required": ["found"]
      },
      "CallHistoryResponse": {
        "type": "object",
        "properties": {
          "calls": {"type": "array", "items": {"$ref": "#/components/schemas/Call"}},
          "total": {"type": "integer"},
          "page": {"type": "integer"},
          "limit": {"type": "integer"}
        }
      },
      "FollowListResponse": {
        "type": "object",
        "properties": {
          "users": {"type": "array", "items": {"$ref": "#/components/schemas/User"}},
          "total": {"type": "integer"}
        }
      },
      "ReportUserRequest": {
        "type": "object",
        "properties": {
          "reason": {"type": "string", "enum": ["harassment", "inappropriate", "spam", "other"]},
          "description": {"type": "string"}
        },
        "required": ["reason"]
      }
    }
  }
}
