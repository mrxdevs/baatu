      "post": {
        "tags": ["Calls"],
        "summary": "Join matching queue",
        "description": "Join the voice call matching queue with optional preferences",
        "operationId": "joinQueue",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/JoinQueueRequest"}
